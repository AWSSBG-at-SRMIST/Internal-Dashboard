# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# member data exports (contains PII — never commit)
*.csv

# Google service account key files (Google names downloaded keys
# "<project-id>-<key-id-prefix>.json") — extract client_email/private_key
# into .env.local instead and delete the file, never leave it in the repo tree
website-*.json
*-service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
